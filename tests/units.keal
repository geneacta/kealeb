/// Everything kealeb can be held to without a socket.
///
///     tools/test.sh
///
/// Each check is an `assert` with a message that says what was expected, so
/// a failure names itself. The count at the end is the only output on
/// success — a test suite that prints while it passes teaches people to stop
/// reading it.

import "../src/app.keal"
import "../src/bytes.keal"
import "../src/css.keal"
import "../src/http.keal"
import "../src/json.keal"
import "../src/router.keal"
import "../src/server.keal"
import "../src/text.keal"
import "../src/live.keal"
import "../src/theme.keal"
import "../src/ui.keal"
import "../src/upload.keal"
import "../src/ws.keal"

var checks = 0

proc ok(condition: Bool, what: String) {
    checks = checks + 1
    assert(condition, what)
}

proc same(got: String, want: String, what: String) {
    checks = checks + 1
    assert(got == want, "${what}: expected `${want}`, got `${got}`")
}

proc sameInt(got: Int, want: Int, what: String) {
    checks = checks + 1
    assert(got == want, "${what}: expected ${want}, got ${got}")
}

// ------------------------------------------------------------------ bytes

proc testBytes() {
    val b = bufOf("hello")
    same(b.all(), "hello", "a buffer holds what was put in it")
    sameInt(b.len, 5, "five bytes")
    same(hex(b), "68656c6c6f", "hex")

    val g = buf(4)
    g.text("abcdefghij")
    same(g.all(), "abcdefghij", "a buffer grows")
    ok(g.cap() >= 10, "and keeps room for what it holds")
    g.drop(3)
    same(g.all(), "defghij", "dropping the front keeps the rest")

    sameInt(bufOf("a\r\n\r\nb").find("\r\n\r\n", 0), 1, "find")
    sameInt(bufOf("abc").find("z", 0), -1, "find, absent")

    same(base64(bufOf("")), "", "base64 of nothing")
    same(base64(bufOf("f")), "Zg==", "base64, two pads")
    same(base64(bufOf("fo")), "Zm8=", "base64, one pad")
    same(base64(bufOf("foo")), "Zm9v", "base64, none")
    same(base64(bufOf("foobar")), "Zm9vYmFy", "base64, two groups")

    val back = unbase64("Zm9vYmFy")
    ok(back != null, "base64 decodes")
    if (back != null) { same(back.all(), "foobar", "and round-trips") }

    // The three vectors every SHA-1 is checked against, and the one from
    // RFC 6455 that the WebSocket handshake is specified by.
    same(hex(sha1(bufOf(""))), "da39a3ee5e6b4b0d3255bfef95601890afd80709", "sha1 of nothing")
    same(hex(sha1(bufOf("abc"))), "a9993e364706816aba3e25717850c26c9cd0d89d", "sha1 abc")
    same(hex(sha1(bufOf("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))),
         "84983e441c3bd26ebaae4aa1f95129e5e54670f1", "sha1, two blocks")
    same(base64(sha1(bufOf("dGhlIHNhbXBsZSBub25jZQ==258EAFA5-E914-47DA-95CA-C5AB0DC85B11"))),
         "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=", "the RFC 6455 accept key")

    same(hex64(255), "00000000000000ff", "hex64")
    sameInt(textBytes("héllo"), 6, "bytes are not characters")
}

// ------------------------------------------------------------------- text

proc testText() {
    same(percentDecode("a%20b"), "a b", "percent-decoding")
    same(percentDecode("a+b", true), "a b", "plus, in a form")
    same(percentDecode("a+b"), "a+b", "and not, in a path")
    same(percentDecode("caf%C3%A9"), "café", "percent-decoding is bytes, then UTF-8")
    same(percentDecode("%zz"), "%zz", "a malformed escape is left alone")
    same(percentEncode("a b/c"), "a%20b%2Fc", "percent-encoding")
    same(percentEncode("café"), "caf%C3%A9", "and it encodes bytes")

    val f = parseForm("a=1&b=hello+world&c&a=2")
    same(f.get("a") ?: "", "1", "the first value of a repeated field wins")
    same(f.get("b") ?: "", "hello world", "a form's plus is a space")
    same(f.get("c") ?: "?", "", "a field with no value is empty, not absent")

    val all = parseFormAll("x=1&x=2&y=3")
    sameInt((all.get("x") ?: []).size, 2, "every value of a repeated field")

    val c = parseCookies("sid=abc; theme=dark")
    same(c.get("sid") ?: "", "abc", "cookies")
    same(c.get("theme") ?: "", "dark", "and the second one")

    same(httpDate(784111777), "Sun, 06 Nov 1994 08:49:37 GMT", "the one date format HTTP has")
    same(headerKey("  CoNtEnT-TyPe "), "content-type", "header names fold")

    val cut = cutOn("Host: example.com:8080", ":")
    ok(cut != null, "cutOn finds the first separator")
    if (cut != null) {
        same(cut.first, "Host", "the head")
        same(cut.second, " example.com:8080", "and everything after it, once")
    }
}

// ------------------------------------------------------------------- http

proc testHttp() {
    val head = "GET /a/b?x=1&y=deux HTTP/1.1\r\nHost: h\r\nX-A: 1\r\nX-A: 2\r\nCookie: s=t"
    val r = parseHead(head)
    ok(r != null, "a request parses")
    if (r == null) { return }
    same(r.method, "GET", "method")
    same(r.path, "/a/b", "path")
    same(r.target, "/a/b?x=1&y=deux", "target keeps the query")
    same(r.queryOr("y"), "deux", "query")
    same(r.headerOr("HOST", "?"), "h", "a header is found whatever its case")
    same(r.headerOr("x-a", "?"), "1, 2", "a repeated header joins with a comma")
    same(r.cookie("s") ?: "", "t", "a cookie")
    ok(r.keepAlive(), "HTTP/1.1 keeps the connection by default")

    ok(parseHead("nonsense") == null, "a line that is not a request line is refused")
    ok(parseHead("GET /x HTTP/1.1\r\nbad header") == null, "a header with no colon is refused")
    ok(parseHead("GET x HTTP/1.1") == null, "a target that is not a path is refused")

    val old = parseHead("GET / HTTP/1.0\r\nHost: h")
    ok(old != null, "HTTP/1.0 parses")
    if (old != null) { ok(not old.keepAlive(), "and closes by default") }

    val res = html("<p>x</p>").status(201).with("X-Made-By", "kealeb")
    sameInt(res.code, 201, "the status is what was set")
    same(res.headers.get("x-made-by") ?: "", "kealeb", "a response header folds too")
    sameInt(res.length(), 8, "the body's length is in bytes")

    val out = buf(256)
    writeResponse(res, out, false, false)
    val wire = out.all()
    ok(wire.startsWith("HTTP/1.1 201 Created\r\n"), "the status line")
    ok(wire.contains("\r\ncontent-length: 8\r\n"), "the length is written from the body")
    ok(wire.contains("\r\nconnection: close\r\n"), "and the connection is told")
    ok(wire.endsWith("\r\n\r\n<p>x</p>"), "the body follows the blank line")

    val headOut = buf(256)
    writeResponse(res, headOut, false, true)
    ok(headOut.all().contains("content-length: 8"), "HEAD still reports the length")
    ok(not headOut.all().endsWith("<p>x</p>"), "but sends no body")

    same(statusText(404), "Not Found", "a status has a name")
    same(statusText(499), "Client Error", "and one that has none gets its class")
}

// ----------------------------------------------------------------- routing

proc testRouter() {
    val r = Router()
    r.get("/", { req -> text("root") })
    r.get("/user/{id}", { req -> text("user:${req.param("id")}") })
    r.get("/user/new", { req -> text("new") })
    r.post("/user/{id}", { req -> text("post:${req.param("id")}") })
    r.get("/files/{path...}", { req -> text("file:${req.param("path")}") })

    same(dispatch(r, request("GET", "/")).text(), "root", "the root")
    same(dispatch(r, request("GET", "/user/42")).text(), "user:42", "a parameter")
    same(dispatch(r, request("GET", "/user/new")).text(), "new", "a literal beats a parameter")
    same(dispatch(r, request("POST", "/user/7")).text(), "post:7", "the method chooses")
    same(dispatch(r, request("GET", "/files/a/b/c.css")).text(), "file:a/b/c.css", "a tail")
    sameInt(dispatch(r, request("GET", "/nothing")).code, 404, "nothing matches")

    val wrong = dispatch(r, request("DELETE", "/user/1"))
    sameInt(wrong.code, 405, "the path exists but not the verb")
    same(wrong.headers.get("allow") ?: "", "GET, POST", "and it says which verbs it takes")

    same(dispatch(r, request("HEAD", "/")).text(), "root", "HEAD is routed as GET")
    same(dispatch(r, request("GET", "/user/le%20monde")).text(), "user:le monde",
         "a parameter arrives decoded")

    sameInt(segmentsOf("/a//b/").size, 2, "empty segments are dropped")
}

// ---------------------------------------------------------------- the tree

proc testUi() {
    same(render(txt("<b>&</b>")), "&lt;b&gt;&amp;&lt;/b&gt;", "text is escaped")
    same(render(raw("<b>x</b>")), "<b>x</b>", "raw markup is not")
    same(render(el("br")), "<br>", "a void element has no closing tag")
    same(render(el("p").add(txt("x"))), "<p>x</p>", "an element closes")
    same(render(el("div").cls("a").cls("b")), "<div class=\"a b\"></div>", "classes accumulate")
    same(render(el("input").attr("value", "a\"b")), "<input value=\"a&quot;b\">",
         "an attribute is escaped for its quotes")
    same(render(el("input").flag("checked", true)), "<input checked=\"checked\">", "a flag that is on")
    same(render(el("input").flag("checked", false)), "<input>", "and one that is off")

    val clicked = el("button").on("click", { e -> })
    ok(not render(clicked).contains("data-kb"), "a static page carries no event wiring")

    val page = doc("T", column([h1("H")]))
    ok(page.startsWith("<!doctype html>"), "a document starts as one")
    ok(page.contains("<title>T</title>"), "with its title")
    ok(page.contains("/kealeb/kealeb.css"), "and the stylesheet")
    ok(doc("T", txt("x"), "", "").contains("<link") == false, "which can be left out")
}

// ----------------------------------------------------------------- the live

/// The patches a change produces, as text, so that a test can say exactly
/// what should have crossed the wire.
func changes(old: Node, var now: Node): String {
    val table: Map<String, Node> = {}
    prepare(now, "", table)
    val patches: List<Json> = []
    diffNode(old, now, "", patches)
    return jArr(patches).write()
}

proc testLive() {
    same(mountPath, "0", "the tree is the mount point's only child")
    val table: Map<String, Node> = {}
    val tree = column([h1("a"), button("b", { e -> })])
    prepare(tree, mountPath, table)
    ok(table.containsKey("0.1"), "the button is where its path says")
    ok(render(tree).contains("data-kb=\"0.1\""), "and carries that path")
    ok(render(tree).contains("data-kb-on=\"click\""), "and what it listens for")

    same(changes(column([h1("a")]), column([h1("a")])), "[]", "nothing changed, nothing sent")
    same(changes(column([h1("a")]), column([h1("b")])), "[[\"t\",\"0.0\",\"b\"]]",
         "a changed word is one patch")
    same(changes(el("div").cls("a"), el("div").cls("b")), "[[\"a\",\"\",\"class\",\"b\"]]",
         "a changed class is one patch")
    same(changes(el("div").attr("x", "1"), el("div")), "[[\"d\",\"\",\"x\"]]",
         "an attribute that went away is removed")
    same(changes(column([h1("a")]), column([h1("a"), p("b")])),
         "[[\"i\",\"\",\"1\",\"<p>b</p>\"]]", "a new child is inserted")
    same(changes(column([h1("a"), p("b")]), column([h1("a")])),
         "[[\"x\",\"\",\"1\"]]", "a child that went away is removed")
    same(changes(column([h1("a")]), column([p("a")])),
         "[[\"r\",\"0\",\"<p>a</p>\"]]", "a different tag is replaced whole")
    same(changes(column([nothing()]), column([p("x")])),
         "[[\"r\",\"0\",\"<p>x</p>\"]]", "and so is an empty placeholder that grew into one")
    same(render(nothing()), "<!---->", "nothing is one node and no ink")
    same(changes(column([txt("a")]), column([nothing()])),
         "[[\"r\",\"0\",\"<!---->\"]]", "text that empties becomes that node, not empty text")

    // A key says what a node *is*. Same shape, same position, different key:
    // the browser's node goes, and the caret, focus and scroll that came with
    // it go with it rather than being inherited by something else. Two patches
    // rather than one replacement, because a keyed list takes out everything
    // that is leaving before it puts anything in — which is what lets the
    // indices in both of them mean what they say.
    same(changes(column([el("input").keyed("a")]), column([el("input").keyed("b")])),
         "[[\"x\",\"\",\"0\"],[\"i\",\"\",\"0\",\"<input>\"]]",
         "a different key is a different node")
    same(changes(column([el("input").keyed("a")]), column([el("input").keyed("a")])),
         "[]", "and the same key is the same node")
    same(changes(column([el("input").attr("value", "x")]), column([el("input").attr("value", "y")])),
         "[[\"a\",\"0\",\"value\",\"y\"]]", "with no key at all, position is identity")

    // Two children removed: the indices must still name the right ones, which
    // is why they go backwards.
    same(changes(column([h1("a"), p("b"), p("c")]), column([h1("a")])),
         "[[\"x\",\"\",\"2\"],[\"x\",\"\",\"1\"]]", "removals count down")

    val page = liveDoc("T", column([h1("x")]), "abc123")
    ok(page.contains("data-kb-session=\"abc123\"><div"),
       "the mount point names the session and holds the tree, with no whitespace")
    ok(not page.contains("<script>window"), "and there is no inline script to make a content policy excuse for")
    ok(page.contains("/kealeb/kealeb.js"), "and loads the client")

    same(acceptKey("dGhlIHNhbXBsZSBub25jZQ=="), "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=",
         "the handshake key RFC 6455 gives as its example")

    // A frame, masked the way a client must mask one.
    val f = buf(32)
    f.byte(0x81)
    f.byte(0x80 bor 5)
    f.byte(1)
    f.byte(2)
    f.byte(3)
    f.byte(4)
    val keys = [1, 2, 3, 4]
    val payload = bufOf("hello")
    for (i in 0..payload.len) { f.byte(payload.at(i) bxor keys[i % 4]) }
    val frame = readFrame(f, 0, 4096)
    ok(frame != null, "a masked text frame reads")
    if (frame != null) {
        sameInt(frame.opcode, opText, "as text")
        same(frame.payload.all(), "hello", "and unmasks to what was sent")
        sameInt(frame.used, 11, "and says how much of the buffer it took")
    }

    val short = buf(4)
    short.byte(0x81)
    ok(readFrame(short, 0, 4096) == null, "half a frame is not an error, it is not yet")

    val unmasked = buf(8)
    unmasked.byte(0x81)
    unmasked.byte(1)
    unmasked.byte(65)
    val refused = readFrame(unmasked, 0, 4096)
    ok(refused != null, "an unmasked frame from a client is answered")
    if (refused != null) { sameInt(refused.opcode, opBad, "with a refusal") }

    val out = buf(32)
    writeText(out, "hi")
    sameInt(out.at(0), 0x81, "a server frame is final text")
    sameInt(out.at(1), 2, "unmasked, so the length is the length")
    same(out.textAt(2, 2), "hi", "and the payload follows")
}

// ------------------------------------------------------------------- json

proc testJson() {
    val fields: Map<String, Json> = {}
    fields.set("a", jInt(1))
    fields.set("b", jStr("x\"y"))
    fields.set("c", jBool(false))
    same(jObj(fields).write(), "{\"a\":1,\"b\":\"x\\\"y\",\"c\":false}", "writing an object")
    same(jArr([jInt(1), jNull()]).write(), "[1,null]", "writing an array")
    same(jNum(1.5).write(), "1.5", "a number that needs its fraction")
    same(jNum(2.0).write(), "2", "and one that does not")

    val v = parseJson("{\"n\": -3, \"s\": \"caf\\u00e9\", \"a\": [true, null]}")
    ok(v != null, "reading an object")
    if (v == null) { return }
    sameInt(v.intAt("n"), -3, "a negative number")
    same(v.str("s"), "café", "a \\u escape becomes UTF-8")
    val a = v.field("a")
    ok(a != null, "an array field")
    if (a != null) { sameInt(a.size(), 2, "with two elements") }

    ok(parseJson("{") == null, "an object that never closes is refused")
    ok(parseJson("[1,2] and more") == null, "and so is trailing junk")
    ok(parseJson("nope") == null, "and a bare word")
    val emoji = parseJson("\"\\ud83d\\ude00\"")
    ok(emoji != null, "a surrogate pair reads")
    if (emoji != null) { sameInt(emoji.text().length, 1, "as one character") }
}

// ------------------------------------------------------------ the uploads

val bound: String = "----kbBoundary9x"

func posted(body: String): Request {
    val r = parseHead("POST /upload HTTP/1.1\r\nHost: h\r\n" +
                      "Content-Type: multipart/form-data; boundary=" + bound)
    if (r == null) { panic("the test built a request that does not parse") }
    r.body = bufOf(body)
    return r
}

proc testUploads() {
    same(boundaryOf("multipart/form-data; boundary=abc"), "abc", "the boundary, unquoted")
    same(boundaryOf("multipart/form-data; boundary=\"a;b\""), "a;b",
         "and quoted, with a semicolon inside it")
    same(boundaryOf("text/plain"), "", "and none when there is none")

    val params = headerParams("form-data; name=\"a\"; filename=\"x;y.txt\"")
    same(params.get("name") ?: "", "a", "a parameter by name")
    same(params.get("filename") ?: "", "x;y.txt",
         "and one whose quoted value holds the separator")
    same(headerParams("form-data; FileName=\"X\"").get("filename") ?: "", "X",
         "parameter names fold case")

    val body = "--" + bound + "\r\n" +
        "Content-Disposition: form-data; name=\"title\"\r\n\r\n" +
        "Le rapport\r\n" +
        "--" + bound + "\r\n" +
        "Content-Disposition: form-data; name=\"doc\"; filename=\"../../etc/pa;ssw\\\"d.txt\"\r\n" +
        "Content-Type: text/plain; charset=utf-8\r\n\r\n" +
        "hello\r\nworld\r\n" +
        "--" + bound + "\r\n" +
        "Content-Disposition: form-data; name=\"empty\"; filename=\"\"\r\n\r\n" +
        "\r\n" +
        "--" + bound + "--\r\n"

    val req = posted(body)
    ok(req.isMultipart(), "a multipart body says so")
    sameInt(req.parts().size, 3, "three parts")

    val title = req.part("title")
    ok(title != null, "an ordinary field is a part")
    if (title != null) {
        same(title.text(), "Le rapport", "with its value")
        ok(not title.isFile(), "and it is not a file")
    }

    val doc = req.file("doc")
    ok(doc != null, "a file is a part")
    if (doc != null) {
        // The content has a CRLF in it, which is also what separates parts —
        // so this is the check that the boundary scan is a boundary scan and
        // not a line scan.
        same(doc.text(), "hello\r\nworld", "whose content survives a CRLF inside it")
        sameInt(doc.size(), 12, "counted in bytes")
        same(doc.kind, "text/plain", "with the media type, and without its parameters")
        // `name=` must not match inside `filename=`, and a `;` inside the
        // quotes must not end the parameter. Both are here on purpose.
        same(doc.filename, "../../etc/pa;ssw\"d.txt", "and the name exactly as it was sent")
        same(doc.safeName(), "pa_ssw_d.txt",
             "which is never a path once it has been through safeName")
    }

    ok(req.file("empty") == null, "a file input nobody chose a file for is not a file")
    ok(req.part("empty") != null, "though it is still a part")
    ok(req.part("nope") == null, "and a name nothing sent is null")

    val plain = parseHead("POST /x HTTP/1.1\r\nHost: h\r\nContent-Type: application/x-www-form-urlencoded")
    ok(plain != null, "an ordinary form parses")
    if (plain != null) {
        ok(not plain.isMultipart(), "and is not multipart")
        ok(plain.parts().isEmpty(), "so it has no parts, rather than failing to have them")
    }

    // Half a body is something a handler can notice. A panic in the parser is
    // something it cannot.
    val truncated = posted("--" + bound + "\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nvalue")
    ok(truncated.parts().isEmpty(), "a truncated body answers what it managed, and does not throw")

    same(Part("f", "", "", bufOf("")).safeName(), "upload", "a part with no name gets the fallback")
    same(Part("f", "..", "", bufOf("")).safeName(), "upload", "and so does one that is only dots")
    same(Part("f", "C:\\Users\\ada\\photo.png", "", bufOf("")).safeName(), "photo.png",
         "a Windows path keeps only its last segment")
}

// -------------------------------------------------------- the keyed lists

func keyedList(keys: List<String>): Node {
    val kids: List<Node> = []
    for (k in keys) { kids.add(el("li").add(txt(k)).keyed(k)) }
    return elt("ul", kids)
}

func moves(a: List<String>, b: List<String>): String {
    return changes(keyedList(a), keyedList(b))
}

proc testKeyed() {
    same(moves(["b", "c"], ["a", "b", "c"]),
         "[[\"i\",\"\",\"0\",\"<li>a</li>\"]]",
         "inserting at the front is one insert, not a rewrite of everything after it")
    same(moves(["a", "c"], ["a", "b", "c"]),
         "[[\"i\",\"\",\"1\",\"<li>b</li>\"]]", "and in the middle, one too")
    same(moves(["a", "b", "c"], ["b", "c"]), "[[\"x\",\"\",\"0\"]]",
         "removing from the front is one removal")
    same(moves(["a", "b"], ["b", "a"]), "[[\"m\",\"\",\"1\",\"0\"]]",
         "a swap is one move")
    same(moves(["a", "b", "c"], ["c", "b", "a"]),
         "[[\"m\",\"\",\"2\",\"0\"],[\"m\",\"\",\"2\",\"1\"]]",
         "reversing three is two moves")
    same(moves(["a", "b", "c", "d"], ["d", "a", "b", "c"]),
         "[[\"m\",\"\",\"3\",\"0\"]]", "and pulling the last one to the front is one")
    same(moves(["a", "b"], ["a", "b"]), "[]", "nothing changed, nothing sent")

    // A move only ever pulls a node earlier, which is what makes the two
    // indices in `m` need no rule about what happens after it.
    for (patch in [moves(["a", "b", "c"], ["c", "b", "a"]), moves(["a", "b", "c"], ["b", "c", "a"])]) {
        ok(not patch.contains("\"m\",\"\",\"0\""), "a move never pushes a node later")
    }

    // Content still diffs, at the position the node ended up in.
    val before: List<Node> = [el("li").add(txt("one")).keyed("a"), el("li").add(txt("two")).keyed("b")]
    val after: List<Node> = [el("li").add(txt("TWO")).keyed("b"), el("li").add(txt("one")).keyed("a")]
    same(changes(elt("ul", before), elt("ul", after)),
         "[[\"m\",\"\",\"1\",\"0\"],[\"t\",\"0.0\",\"TWO\"]]",
         "a node that moved and changed is moved, then changed where it landed")

    // Half a list with keys means something the framework cannot work out, and
    // a repeated key names two different things. Both fall back to position,
    // which is always correct and sometimes wasteful.
    val dupA: List<Node> = [el("li").add(txt("x")).keyed("k"), el("li").add(txt("y")).keyed("k")]
    val dupB: List<Node> = [el("li").add(txt("y")).keyed("k"), el("li").add(txt("x")).keyed("k")]
    ok(not changes(elt("ul", dupA), elt("ul", dupB)).contains("\"m\""),
       "a repeated key falls back to matching by position")
    val halfA: List<Node> = [el("li").add(txt("x")).keyed("k"), el("li").add(txt("y"))]
    val halfB: List<Node> = [el("li").add(txt("y")), el("li").add(txt("x")).keyed("k")]
    ok(not changes(elt("ul", halfA), elt("ul", halfB)).contains("\"m\""),
       "and so does a list only half of which is keyed")
}

// -------------------------------------------------------------- the filters

proc testFilters() {
    val site = app("filters")
    site.log = false
    val trail: List<String> = []

    site.use({ req, next ->
        trail.add("outer in")
        val res = next.on(req)
        trail.add("outer out")
        res.with("x-outer", "1")
    })
    site.use({ req, next ->
        trail.add("inner in")
        val res = next.on(req)
        trail.add("inner out")
        res
    })
    site.use({ req, next ->
        if (req.path.startsWith("/no")) { notFound("not for you").status(403) } else { next.on(req) }
    })
    site.get("/", { req -> trail.add("handler"); text("hi") })
    site.get("/no/thing", { req -> trail.add("handler"); text("never") })

    val s = site.serverOn(0)
    val answered = s.handle(request("GET", "/"))
    same(answered.text(), "hi", "the handler answers through the filters")
    same(answered.headers.get("x-outer") ?: "", "1", "and a filter may change what comes back")
    same(trail.join(" "), "outer in inner in handler inner out outer out",
         "filters run outermost first, and unwind in the other direction")

    trail.clear()
    val refused = s.handle(request("GET", "/no/thing"))
    sameInt(refused.code, 403, "a filter that does not call next has answered")
    ok(not trail.contains("handler"), "and the handler never ran")
    ok(trail.contains("outer out"), "while the filters outside it still unwound")
}

// --------------------------------------------------------------- the styles

proc testCss() {
    same(sheet([rule(".a").fg("red")]), ".a {\n  color: red;\n}\n", "one rule")
    same(sheet([rule(".a").fg("red").bg("blue")]),
         ".a {\n  color: red;\n  background: blue;\n}\n", "two declarations, in order")
    same(sheet([]), "", "no rules is no stylesheet")
    same(sheet([rule(".a").set("--x", "1")]), ".a {\n  --x: 1;\n}\n",
         "a custom property is a property")
    sameInt(vars(":root", [("--a", "1"), ("--b", "2")]).count(), 2, "vars sets each pair")
    same(sheet([media("(min-width: 40em)", [rule(".a").pad("1rem")])]),
         "@media (min-width: 40em) {\n  .a {\n    padding: 1rem;\n  }\n}\n",
         "an at-rule nests and indents")
    ok(sheet([supports("(display: grid)", [rule(".g").display("grid")])]).startsWith("@supports"),
       "and so does @supports")

    // A rule is a value, which is the whole reason this exists rather than a
    // string: it can be built from a loop.
    val many: List<Rule> = []
    for (i in 1..4) { many.add(rule(".c${i}").width("${i * 25}%")) }
    val built = sheet(many)
    ok(built.contains(".c1 {") and built.contains(".c3 {"), "rules built from a loop")
    ok(built.contains("width: 75%;"), "each with its own value")
}

// ------------------------------------------------------------- the schedule

proc boom() { throw "on purpose" }

proc testSchedule() {
    val s = server(Router(), 0)
    s.log = false
    sameInt(s.timerCount(), 0, "a new server has no timers")

    var ticks = 0
    var once = 0
    s.every(5, { -> ticks = ticks + 1 })
    val shot = s.after(5, { -> once = once + 1 })
    sameInt(s.timerCount(), 2, "two installed")

    var turns = 0
    while (turns < 12) {
        s.tick(5)
        turns = turns + 1
    }
    ok(ticks >= 3, "the repeating job ran more than once (${ticks})")
    sameInt(once, 1, "and the one-shot ran exactly once")
    sameInt(s.timerCount(), 1, "which is why it is no longer installed")

    val before = ticks
    s.every(5, { -> ticks = ticks + 1 }).cancel()
    s.tick(10)
    ok(ticks > before, "the surviving job still runs")
    sameInt(s.timerCount(), 1, "and a job cancelled before its first run is forgotten")

    // A job that throws is reported and keeps its schedule: a batch that
    // fails once should still be tried next time, and must not take the
    // server with it.
    var angry = 0
    println("")
    println("  (the next two lines are the framework reporting a job that throws,")
    println("   which is what this check is about)")
    // Through a `proc` rather than `{ -> ... throw ... }`: a lambda whose last
    // expression is a `throw` has type `Nothing`, which the C backend refuses
    // by name. Nothing is broken by it; the shape just has to be written the
    // other way round.
    s.every(5, { -> angry = angry + 1; boom() })
    s.tick(10)
    s.tick(10)
    ok(angry >= 2, "a job that throws is run again (${angry})")
    print("  ")
}

// -------------------------------------------------------------- the assets

proc testAssets() {
    same(mimeOf("a/b/c.css"), "text/css; charset=utf-8", "a media type")
    same(mimeOf("x.PNG"), "image/png", "whatever its case")
    same(mimeOf("noextension"), "application/octet-stream", "and one that cannot be known")

    ok(safePath("a/b.css"), "an ordinary path")
    ok(not safePath("../etc/passwd"), "a path that climbs is refused")
    ok(not safePath("a/../../b"), "wherever it climbs")
    ok(not safePath("/etc/passwd"), "an absolute path is refused")
    ok(not safePath("a\\b"), "a backslash is refused")
    ok(not safePath(".ssh/id"), "and so is a dotfile")
    ok(safePath("a/.b/c") == false, "at any depth")
}

testBytes()
testText()
testHttp()
testRouter()
testUi()
testJson()
testLive()
testCss()
testKeyed()
testUploads()
testFilters()
testSchedule()
testAssets()
println("${checks} checks passed")

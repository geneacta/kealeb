/// The server: one thread, one `poll`, and a state machine per connection.
///
/// Every socket is non-blocking and nothing ever waits on one. The loop asks
/// the kernel which descriptors are ready, moves what it can on each, and
/// goes back to sleep. A handler therefore runs to completion with nothing
/// else running — session state is an ordinary Keal object, there is no lock
/// anywhere in kealeb, and a race is not a thing that can be written here.
///
/// The cost of that choice is stated plainly rather than hidden: a handler
/// that blocks blocks the server. Handlers are expected to answer and return.
/// Several loops on several cores can be added later without any of this
/// changing shape, because nothing below assumes it is the only one.

import "./bytes.keal"
import "./ffi.keal"
import "./gzip.keal"
import "./http.keal"
import "./router.keal"
import "./text.keal"
import "./ws.keal"

/// A connection is reading requests, or it has been handed over to the
/// WebSocket framing and is reading frames. Those are the two states, and the
/// switch between them happens once, in `consume`.
package val modeHttp: Int = 0
package val modeSocket: Int = 1

/// Something to do later, or repeatedly.
///
/// The loop already sleeps in `poll` with a deadline; a timer is that deadline
/// being chosen by something other than a guess. So this costs a comparison
/// per turn and nothing else, and a server with no timers sleeps exactly as it
/// did before.
public class Timer(
    /// How long between runs, in milliseconds.
    public val everyMs: Int,
    package var dueMs: Int,
    /// Once and then gone, or over and over.
    public val once: Bool,
    package val run: () -> Unit,
    package var cancelled: Bool
) {
    /// Stop it. A timer already running is not interrupted; it will not run
    /// again. Cancelling one twice is not an error.
    public proc cancel() { this.cancelled = true }

    /// Run it on the next turn of the loop rather than when it was due.
    public proc soon() { this.dueMs = monoMs() }
}

/// One live connection.
public class Conn(
    public val fd: Int,
    package val inBuf: Buf,
    package val outBuf: Buf,
    /// How much of `outBuf` has left the machine.
    package var sent: Int,
    /// Where the header scan stopped last time, so a slow trickle of bytes
    /// does not rescan what it has already seen.
    package var scanned: Int,
    package var closeWhenDrained: Bool,
    package var mode: Int,
    package var lastMs: Int,
    /// How many requests this connection has answered — the number a
    /// keep-alive limit counts.
    package var served: Int,
    public var peer: String,
    /// A message being assembled out of continuation frames.
    package var partial: Buf,
    package var partialOp: Int,
    /// A file this connection is in the middle of sending: the open handle,
    /// and how many bytes of it are still owed. Zero means none.
    package var sending: Int,
    package var sendLeft: Int,
    /// A body this connection is in the middle of receiving into a file: the
    /// open handle, where it is going, how much is still to come, and the
    /// request it belongs to. Zero means none.
    package var spooling: Int,
    package var spoolPath: String,
    package var spoolLeft: Int,
    package var pending: Request?,
    package var pendingKeep: Bool
)

func newConn(fd: Int, peer: String): Conn {
    return Conn(fd, buf(2048), buf(2048), 0, 0, false, modeHttp, monoMs(), 0, peer, buf(16), opText, 0, 0, 0, "", 0, null, false)
}

/// The server.
///
/// `handle` is what answers a request. It defaults to dispatching through
/// `router`, and a program that wants something else — a filter chain, a
/// single function, a proxy — replaces it and keeps everything else.
public class Server(
    /// The routing table `handle` reads by default.
    public val router: Router,
    /// The address to bind. `127.0.0.1` while developing, `""` for every
    /// interface. The default is the one that cannot surprise anybody.
    public var host: String,
    /// The port. 0 asks the machine for a free one, which `port()` then
    /// reports — what a test wants.
    public var port: Int,
    /// The whole of request handling, as one function.
    public var handle: (Request) -> Response,
    /// A line per request on standard output.
    public var log: Bool,
    /// The largest request head accepted, in bytes. Bigger is 431.
    public var maxHead: Int,
    /// The largest body accepted, in bytes. Bigger is 413.
    public var maxBody: Int,
    /// How long a connection may sit idle before it is closed, in
    /// milliseconds.
    public var idleMs: Int,
    /// Compress a response when the client says it can read gzip, the body is
    /// worth compressing, and it is big enough to be worth the header.
    public var compress: Bool,
    /// Below this many bytes, compressing is not worth the twenty-three bytes
    /// a gzip stream costs before it says anything.
    public var compressFrom: Int,
    /// A body bigger than this is written to a file as it arrives rather than
    /// held. Above it, `maxBody` costs disk instead of memory, so it can be
    /// raised to whatever an upload should be allowed to be.
    public var spoolFrom: Int,
    /// Where those files go. They are deleted when the request is done.
    public var spoolDir: String,
    /// How many requests one connection may serve before it is asked to go
    /// away. A bound, not a policy — it keeps a client from pinning a slot
    /// for ever.
    public var maxRequests: Int,
    /// A connection has become a WebSocket. The request that asked is given
    /// too, because everything the socket needs to know about who is on the
    /// other end — a cookie, a query parameter — was in it.
    public var onOpen: (Int, Request) -> Unit,
    /// A complete text message arrived on a WebSocket.
    public var onMessage: (Int, String) -> Unit,
    /// A WebSocket went away, for any reason.
    public var onClose: (Int) -> Unit,
    /// Run once when the server is stopping, before anything is closed. What
    /// a program uses to write a last line, or flush something of its own.
    public var onStop: () -> Unit,
    /// How long to spend letting open connections finish once a stop has been
    /// asked for, in milliseconds. After that they are closed anyway: a
    /// shutdown that waits for ever is a process somebody has to kill.
    public var drainMs: Int,
    package var listenFd: Int,
    package var conns: Map<Int, Conn>,
    package var timers: List<Timer>,
    package var stopping: Bool
) {
    /// Run `job` every `ms`, for as long as the server runs.
    ///
    /// It runs on the loop's own thread, between requests and never during
    /// one, so it may read and write whatever a handler reads and writes with
    /// nothing to synchronise. The price is the same as a handler's: a job
    /// that blocks blocks the server, and a job that takes longer than its
    /// interval simply runs less often than it asked — it is never started
    /// twice.
    public func every(ms: Int, job: () -> Unit): Timer {
        val t = Timer(ms < 1 ? 1 : ms, monoMs() + ms, false, job, false)
        this.timers.add(t)
        return t
    }

    /// Run `job` once, `ms` from now.
    public func after(ms: Int, job: () -> Unit): Timer {
        val t = Timer(ms < 0 ? 0 : ms, monoMs() + ms, true, job, false)
        this.timers.add(t)
        return t
    }

    /// How many timers are installed.
    public func timerCount(): Int { return this.timers.size }
    /// Bind, and answer the port actually taken. Called by `run`; call it
    /// yourself when you need the port before serving — a test does.
    public func open(): Int {
        if (this.listenFd >= 0) { return this.port }
        ignoreSigpipe()
        stdoutLines()
        val fd = listenOn(this.host, this.port, 512)
        if (fd < 0) {
            val why = when (fd) {
                -1 -> "the machine refused a socket"
                -2 -> "`${this.host}` is not an IPv4 address"
                -3 -> "port ${this.port} is already taken"
                else -> "the machine refused to listen"
            }
            panic("kealeb could not start: ${why}")
        }
        this.listenFd = fd
        this.port = localPort(fd)
        watch(fd, readable)
        return this.port
    }

    /// Serve until `stop` is called — which, with one thread, means until a
    /// handler calls it.
    public proc run() {
        this.open()
        catchStop()
        if (this.log) {
            val shown = this.host.isEmpty() ? "0.0.0.0" : this.host
            println("kealeb listening on http://${shown}:${this.port}")
        }
        while (not this.stopping) {
            this.tick(200)
            if (stopAsked() == 1) { this.stopping = true }
        }
        this.drain()
        this.shut()
    }

    /// Stop taking new connections, and let the ones in hand finish.
    ///
    /// Closing the listener first is what makes this graceful rather than
    /// merely delayed: a client that connects after this point is refused by
    /// the kernel and can go to another instance, while a client already
    /// waiting on a response gets it. Everything still open after `drainMs` is
    /// closed anyway, because a shutdown that waits for ever is a process
    /// somebody has to kill — and being killed is exactly what this exists to
    /// avoid.
    proc drain() {
        try {
            this.onStop()
        } catch (e) {
            println("kealeb: the stop handler threw: ${e}")
        }
        if (this.listenFd >= 0) {
            unwatch(this.listenFd)
            closeFd(this.listenFd)
            this.listenFd = -1
        }
        if (this.conns.isEmpty()) { return }
        if (this.log) { println("kealeb: stopping, ${this.conns.size} connection(s) to finish") }
        val until = monoMs() + this.drainMs
        while ((not this.conns.isEmpty()) and (monoMs() < until)) {
            // Two kinds of connection, and only one of them is worth waiting
            // for. One with bytes still unsent is in the middle of an answer,
            // and finishing it is the whole point. One with nothing owed is a
            // keep-alive sitting idle, or a socket with no news — it has
            // nothing to finish, and waiting for it would mean waiting the
            // full timeout every time, which is what this did before the test
            // that stops a server measured how long it took.
            val idle: List<Conn> = []
            for (fd in this.conns.keys()) {
                val c = this.conns.get(fd)
                if (c == null) { continue }
                c.closeWhenDrained = true
                if ((c.sent >= c.outBuf.len) and (c.sending == 0)) { idle.add(c) }
            }
            for (c in idle) { this.drop(c) }
            if (this.conns.isEmpty()) { break }
            this.tick(20)
        }
        if (this.log and (not this.conns.isEmpty())) {
            println("kealeb: ${this.conns.size} connection(s) did not finish in ${this.drainMs}ms; closing them")
        }
    }

    /// One turn of the loop: wait up to `ms`, then move whatever is ready.
    /// Exposed because a test wants to drive the server by hand, and because
    /// a program that has its own loop should be able to host this one.
    ///
    /// A timer due sooner than `ms` shortens the wait, which is the whole of
    /// how timers are implemented: the loop was already sleeping with a
    /// deadline, and this is that deadline being chosen rather than assumed.
    public proc tick(ms: Int) {
        var wait = ms
        val now = monoMs()
        for (t in this.timers) {
            if (t.cancelled) { continue }
            val left = t.dueMs - now
            if (left < wait) { wait = left < 0 ? 0 : left }
        }
        val n = pollWait(wait)
        var i = 0
        while (i < n) {
            val fd = readyFd(i)
            val ev = readyEvents(i)
            i = i + 1
            if (fd == this.listenFd) {
                this.acceptAll()
                continue
            }
            val c = this.conns.get(fd)
            if (c == null) { continue }
            if ((ev band gone) != 0) { this.drop(c); continue }
            if ((ev band readable) != 0) {
                if (not this.readFrom(c)) { continue }
            }
            if ((ev band writable) != 0) { this.flush(c) }
        }
        this.fire()
        this.sweep()
    }

    /// Run whatever fell due, and forget what will not run again.
    ///
    /// The list is copied first: a job may install a timer or cancel one, and
    /// a list being walked is not a list to change. A job that throws is
    /// reported and its timer keeps its schedule — a batch that fails once an
    /// hour should still be tried next hour, and a server that dies because a
    /// scheduled job did is worse than the job failing.
    proc fire() {
        if (this.timers.isEmpty()) { return }
        val now = monoMs()
        val due: List<Timer> = []
        for (t in this.timers) {
            if ((not t.cancelled) and (t.dueMs <= now)) { due.add(t) }
        }
        for (t in due) {
            if (t.once) { t.cancelled = true } else { t.dueMs = monoMs() + t.everyMs }
            try {
                t.run()
            } catch (e) {
                println("kealeb: a timer threw: ${e}")
            }
        }
        val living: List<Timer> = []
        for (t in this.timers) {
            if (not t.cancelled) { living.add(t) }
        }
        this.timers = living
    }

    /// Ask the loop to stop at the end of this turn.
    public proc stop() { this.stopping = true }

    /// How many connections are open.
    public func connections(): Int { return this.conns.size }

    // ------------------------------------------------------------ inwards

    proc acceptAll() {
        while (true) {
            val fd = acceptOn(this.listenFd)
            if (fd < 0) { return }
            if (watch(fd, readable) == 0) {
                // The watch set is full. Refusing here, now, is the honest
                // answer; accepting and never reading is not.
                closeFd(fd)
                continue
            }
            this.conns.set(fd, newConn(fd, peerOf(fd)))
        }
    }

    /// Read what is waiting. Answers false when the connection is gone.
    func readFrom(var c: Conn): Bool {
        while (true) {
            c.inBuf.reserve(65536)
            val got = recvInto(c.fd, c.inBuf.handle(), c.inBuf.len, 65536)
            if (got == again) { break }
            if (got <= 0) { this.drop(c); return false }
            c.inBuf.len = c.inBuf.len + got
            c.lastMs = monoMs()

            // A body going to a file is drained here rather than after the
            // loop, and the difference is the whole point of spooling: the
            // kernel will hand over as much as it has, so a sixty-megabyte
            // upload arrives faster than one turn of the loop and the read
            // buffer grows to hold all of it — measured at 133 MB resident
            // before this line existed, and 3 MB after.
            if (c.spooling != 0) {
                if (not this.spoolFrom_(c)) { return false }
                if (c.spooling == 0) { break }
                continue
            }

            // And a request that is not being spooled still should not read
            // for ever before anything looks at it.
            if (c.inBuf.len >= 262144) { break }
            if (got < 65536) { break }
        }
        if (c.mode == modeSocket) { return this.consumeFrames(c) }
        return this.consume(c)
    }

    /// Take every complete request out of the buffer. Answers false when the
    /// connection has been dropped along the way.
    func consume(var c: Conn): Bool {
        while (true) {
            // A body being written to a file takes everything that arrives
            // until it has all of it; nothing else can be read from this
            // connection meanwhile, because nothing else has been sent.
            if (c.spooling != 0) {
                if (not this.spoolFrom_(c)) { return false }
                if (c.spooling != 0) { return true }
            }
            val from = c.scanned > 3 ? c.scanned - 3 : 0
            val end = c.inBuf.find("\r\n\r\n", from)
            if (end < 0) {
                c.scanned = c.inBuf.len
                if (c.inBuf.len > this.maxHead) {
                    this.fail(c, 431, "Request header fields too large")
                    return false
                }
                return true
            }
            val head = c.inBuf.textAt(0, end)
            val req = parseHead(head)
            if (req == null) {
                this.fail(c, 400, "Malformed request")
                return false
            }
            if (req.hasHeader("transfer-encoding")) {
                // Chunked request bodies are not read yet, and saying so is
                // better than reading the head of one as the whole of it.
                this.fail(c, 501, "Chunked request bodies are not supported yet")
                return false
            }
            val lengthText = req.headerOr("content-length", "0").trim()
            val length = lengthText.toInt() ?: -1
            if (length < 0) {
                this.fail(c, 400, "Bad Content-Length")
                return false
            }
            if (length > this.maxBody) {
                this.fail(c, 413, "Body too large")
                return false
            }
            val bodyAt = end + 4
            val keep = req.keepAlive() and (c.served < this.maxRequests - 1)
            req.peer = c.peer
            req.bodySize = length

            if (length > this.spoolFrom) {
                // Too big to hold. Everything from here goes to a file as it
                // arrives, and the request waits until the last byte does.
                if (req.headerOr("expect", "").toLower().contains("100-continue")) {
                    c.outBuf.text("HTTP/1.1 100 Continue\r\n\r\n")
                    if (not this.flush(c)) { return false }
                }
                if (not this.beginSpooling(c, req, keep)) { return false }
                c.inBuf.drop(bodyAt)
                c.scanned = 0
                c.served = c.served + 1
                if (not this.spoolFrom_(c)) { return false }
                if (c.spooling != 0) { return true }
                continue
            }

            if (c.inBuf.len < bodyAt + length) {
                if (req.headerOr("expect", "").toLower().contains("100-continue")) {
                    c.outBuf.text("HTTP/1.1 100 Continue\r\n\r\n")
                    this.flush(c)
                }
                return true
            }
            if (length > 0) {
                val body = buf(length)
                body.raw(c.inBuf.handle(), bodyAt, length)
                req.body = body
            }
            c.inBuf.drop(bodyAt + length)
            c.scanned = 0
            c.served = c.served + 1

            val started = monoMs()
            val res = this.answer(req)
            if (res.upgrade) {
                writeSwitch(res, c.outBuf)
                c.mode = modeSocket
                c.scanned = 0
                if (this.log) {
                    println("${req.method} ${req.target} → ${res.code} websocket ${c.peer}")
                }
                if (not this.flush(c)) { return false }
                this.onOpen(c.fd, req)
                return this.consumeFrames(c)
            }
            if (this.compress) { squeeze(req, res, this.compressFrom) }
            writeResponse(res, c.outBuf, keep, req.method == "HEAD")
            if (res.streams() and (req.method != "HEAD")) {
                if (not this.beginSending(c, res)) { return false }
            }
            if (this.log) {
                println("${req.method} ${req.target} → ${res.code} ${res.length()}b ${monoMs() - started}ms ${c.peer}")
            }
            if (not keep) { c.closeWhenDrained = true }
            if (not this.flush(c)) { return false }
            if (c.closeWhenDrained) { return false }
        }
        return true
    }

    /// Start writing a body to a file.
    func beginSpooling(var c: Conn, var req: Request, keep: Bool): Bool {
        val name = "${this.spoolDir}/kb-body-${hex64(secureRandom())}.tmp"
        val h = openWrite(name)
        if (h == 0) {
            println("kealeb: could not open ${name} to spool a body")
            this.fail(c, 500, "Could not take that body")
            return false
        }
        c.spooling = h
        c.spoolPath = name
        c.spoolLeft = req.bodySize
        req.bodyPath = name
        c.pending = req
        c.pendingKeep = keep
        return true
    }

    /// Move what has arrived into the file, and answer the request when the
    /// last byte is in. The trailing underscore is not a style: `spoolFrom` is
    /// already the name of the threshold.
    func spoolFrom_(var c: Conn): Bool {
        if (c.spooling == 0) { return true }
        var take = c.inBuf.len
        if (take > c.spoolLeft) { take = c.spoolLeft }
        if (take > 0) {
            if (writeFrom(c.spooling, c.inBuf.handle(), 0, take) != take) {
                println("kealeb: could not write to ${c.spoolPath}")
                this.endSpooling(c, true)
                this.fail(c, 500, "Could not take that body")
                return false
            }
            c.inBuf.drop(take)
            c.spoolLeft = c.spoolLeft - take
            c.lastMs = monoMs()
        }
        if (c.spoolLeft > 0) { return true }

        closeWrite(c.spooling)
        c.spooling = 0
        val req = c.pending
        c.pending = null
        if (req == null) { return true }
        val keep = c.pendingKeep

        val started = monoMs()
        val res = this.answer(req)
        // The file is the request's, and the request is over.
        removePath(c.spoolPath)
        c.spoolPath = ""
        if (res.upgrade) {
            this.fail(c, 400, "A body cannot be followed by an upgrade")
            return false
        }
        if (this.compress) { squeeze(req, res, this.compressFrom) }
        writeResponse(res, c.outBuf, keep, req.method == "HEAD")
        if (res.streams() and (req.method != "HEAD")) {
            if (not this.beginSending(c, res)) { return false }
        }
        if (this.log) {
            println("${req.method} ${req.target} → ${res.code} ${res.length()}b ${monoMs() - started}ms ${c.peer} (${req.bodySize}b spooled)")
        }
        if (not keep) { c.closeWhenDrained = true }
        if (not this.flush(c)) { return false }
        return not c.closeWhenDrained
    }

    /// Stop and forget a body being spooled.
    proc endSpooling(var c: Conn, remove: Bool) {
        if (c.spooling != 0) { closeWrite(c.spooling) }
        c.spooling = 0
        if (remove and (not c.spoolPath.isEmpty())) { removePath(c.spoolPath) }
        c.spoolPath = ""
        c.spoolLeft = 0
        c.pending = null
    }

    /// Run the handler, and turn anything it throws into a 500 rather than
    /// into a dead server.
    ///
    /// This is the backstop. An application built through `App` catches a
    /// handler's throw closer in, around the router, so that its filters see
    /// the 500 — what reaches here is something a *filter* threw, or a
    /// `handle` somebody replaced wholesale. Either way the server does not
    /// die for it, and what went wrong is on standard output rather than
    /// nowhere.
    func answer(req: Request): Response {
        try {
            return this.handle(req)
        } catch (e) {
            println("kealeb: handler for ${req.method} ${req.path} threw: ${e}")
            return serverError()
        }
    }

    /// Take every complete frame out of the buffer. A control frame is
    /// answered here — a ping with a pong, a close with a close — because
    /// none of them is a message and none of them is the application's
    /// business.
    func consumeFrames(var c: Conn): Bool {
        while (true) {
            val f = readFrame(c.inBuf, 0, this.maxBody)
            if (f == null) {
                if (c.inBuf.len > this.maxBody) {
                    this.closeSocket(c, 1009, "frame too large")
                    return false
                }
                return true
            }
            if (f.opcode == opBad) {
                this.closeSocket(c, 1002, "protocol error")
                return false
            }
            c.inBuf.drop(f.used)
            c.lastMs = monoMs()

            if (f.opcode == opClose) {
                this.closeSocket(c, 1000, "")
                return false
            }
            if (f.opcode == opPing) {
                writeFrame(c.outBuf, opPong, f.payload)
                if (not this.flush(c)) { return false }
                continue
            }
            if (f.opcode == opPong) { continue }

            if (f.opcode == opContinue) {
                c.partial.join(f.payload, 0, f.payload.len)
            } else {
                c.partial.clear()
                c.partial.join(f.payload, 0, f.payload.len)
                c.partialOp = f.opcode
            }
            if (not f.fin) {
                if (c.partial.len > this.maxBody) {
                    this.closeSocket(c, 1009, "message too large")
                    return false
                }
                continue
            }
            if (c.partialOp == opText) {
                val message = c.partial.all()
                c.partial.clear()
                try {
                    this.onMessage(c.fd, message)
                } catch (e) {
                    println("kealeb: a socket handler threw: ${e}")
                }
                if (not this.conns.containsKey(c.fd)) { return false }
                if (not this.flush(c)) { return false }
            } else {
                // Binary messages have no meaning in kealeb's own protocol,
                // and inventing one here would be inventing it in the wrong
                // file. They are dropped, deliberately and silently.
                c.partial.clear()
            }
        }
        return true
    }

    /// Send a text message on a WebSocket. Does nothing when the descriptor
    /// is not one, which is what a session that has already gone away is.
    public proc send(fd: Int, message: String) {
        val c = this.conns.get(fd)
        if (c == null) { return }
        if (c.mode != modeSocket) { return }
        writeText(c.outBuf, message)
        this.flush(c)
    }

    /// Close a WebSocket politely, then drop it.
    public proc closeSocket(var c: Conn, code: Int, reason: String) {
        writeClose(c.outBuf, code, reason)
        c.closeWhenDrained = true
        this.flush(c)
        if (this.conns.containsKey(c.fd)) { this.drop(c) }
    }

    /// Open the file a response named, and remember how much of it is owed.
    ///
    /// A file that will not open after the headers have already been written
    /// is a response that cannot be completed and cannot be corrected — the
    /// status line has gone. The connection is dropped, which is the only
    /// honest thing left: a short body with a `Content-Length` that promised
    /// more is a client that waits for ever.
    func beginSending(var c: Conn, res: Response): Bool {
        val h = openRead(res.filePath)
        if (h == 0) {
            println("kealeb: could not open ${res.filePath} after its headers went out; dropping")
            this.drop(c)
            return false
        }
        if (seekTo(h, res.fileFrom) != 1) {
            closeRead(h)
            println("kealeb: could not seek in ${res.filePath}; dropping")
            this.drop(c)
            return false
        }
        c.sending = h
        c.sendLeft = res.fileLen
        return true
    }

    /// Put the next piece of the file into the buffer.
    ///
    /// A quarter of a megabyte at a time: big enough that the read is the cost
    /// rather than the call around it, small enough that a hundred connections
    /// streaming at once is twenty-five megabytes and not the whole file each.
    proc refill(var c: Conn) {
        if ((c.sending == 0) or (c.sendLeft <= 0)) { return }
        var want = 262144
        if (want > c.sendLeft) { want = c.sendLeft }
        val piece = buf(want)
        piece.len = want
        val got = readInto(c.sending, piece.handle(), 0, want)
        if (got <= 0) {
            // The file ended sooner than its size said. The length is already
            // promised, so there is nothing to do but stop and let the
            // connection close short — which a client will notice, and which is
            // better than a loop that never ends.
            println("kealeb: a file being sent ended ${c.sendLeft} bytes early")
            this.stopSending(c)
            c.closeWhenDrained = true
            return
        }
        c.outBuf.raw(piece.handle(), 0, got)
        c.sendLeft = c.sendLeft - got
        if (c.sendLeft <= 0) { this.stopSending(c) }
    }

    proc stopSending(var c: Conn) {
        if (c.sending != 0) { closeRead(c.sending) }
        c.sending = 0
        c.sendLeft = 0
    }

    // ----------------------------------------------------------- outwards

    /// Push what is queued. Answers false when the connection was dropped.
    func flush(var c: Conn): Bool {
        // Top the buffer up from the file before writing, and again whenever
        // it empties: the socket's appetite is what paces the read, which is
        // the whole of the back pressure.
        if ((c.sending != 0) and (c.sent >= c.outBuf.len)) {
            c.outBuf.clear()
            c.sent = 0
            this.refill(c)
        }
        while (c.sent < c.outBuf.len) {
            val n = sendFrom(c.fd, c.outBuf.handle(), c.sent, c.outBuf.len - c.sent)
            if (n == again) {
                watch(c.fd, readable bor writable)
                return true
            }
            if (n <= 0) { this.drop(c); return false }
            c.sent = c.sent + n
            c.lastMs = monoMs()
            if ((c.sending != 0) and (c.sent >= c.outBuf.len)) {
                c.outBuf.clear()
                c.sent = 0
                this.refill(c)
            }
        }
        c.outBuf.clear()
        c.sent = 0
        if (c.sending != 0) {
            watch(c.fd, readable bor writable)
            return true
        }
        if (c.closeWhenDrained) { this.drop(c); return false }
        watch(c.fd, readable)
        return true
    }

    /// Answer with a status and close. Used for the failures that make the
    /// rest of the byte stream meaningless.
    proc fail(var c: Conn, code: Int, message: String) {
        val res = notFound(message).status(code)
        writeResponse(res, c.outBuf, false, false)
        c.closeWhenDrained = true
        this.flush(c)
    }

    proc drop(var c: Conn) {
        this.stopSending(c)
        this.endSpooling(c, true)
        val wasSocket = c.mode == modeSocket
        unwatch(c.fd)
        closeFd(c.fd)
        this.conns.remove(c.fd)
        if (wasSocket) {
            try {
                this.onClose(c.fd)
            } catch (e) {
                println("kealeb: a close handler threw: ${e}")
            }
        }
    }

    /// Close what has been silent too long. A connection nobody is using is
    /// a descriptor somebody else could have.
    proc sweep() {
        if (this.idleMs <= 0) { return }
        val now = monoMs()
        val doomed: List<Conn> = []
        for (fd in this.conns.keys()) {
            val c = this.conns.get(fd)
            if (c == null) { continue }
            if ((now - c.lastMs) > this.idleMs) { doomed.add(c) }
        }
        for (c in doomed) { this.drop(c) }
    }

    proc shut() {
        for (fd in this.conns.keys()) {
            unwatch(fd)
            closeFd(fd)
        }
        this.conns.clear()
        if (this.listenFd >= 0) {
            unwatch(this.listenFd)
            closeFd(this.listenFd)
            this.listenFd = -1
        }
    }
}

/// Which media types are worth compressing.
///
/// Text and the things that are text underneath. Everything else is already
/// compressed — a PNG, a font, a video — and running it through DEFLATE spends
/// milliseconds to make it very slightly bigger. The list is short on purpose:
/// a type nobody serves is a type nobody has to read past, and anything not
/// named here is simply sent as it is.
public func worthCompressing(contentType: String): Bool {
    val kind = contentType.toLower()
    if (kind.startsWith("text/")) { return true }
    for (named in ["application/json", "application/javascript", "application/xml",
                   "application/wasm", "image/svg+xml", "application/x-ndjson"]) {
        if (kind.startsWith(named)) { return true }
    }
    return false
}

/// Compress a response in place, when it is worth it.
///
/// `Vary: Accept-Encoding` goes on **whether or not** it compressed, and that
/// is the part everybody forgets: a cache that stored the compressed answer
/// without it will hand it to the next client along, who may not be able to
/// read it. The header says the answer depends on what was asked for.
package proc squeeze(req: Request, var res: Response, from: Int) {
    if (res.upgrade) { return }
    if (res.code == 304) { return }
    // A range names bytes of the resource as it is, so a compressed 206 would
    // be a slice of something the client did not ask for.
    if (res.code == 206) { return }
    // A body that is a file is never in memory, so there is nothing here to
    // compress without holding a DEFLATE stream per connection — and the
    // things big enough to be streamed are the things already compressed.
    if (res.streams()) { return }
    if (not worthCompressing(res.headers.get("content-type") ?: "")) { return }
    res.with("vary", "accept-encoding")
    if (res.headers.containsKey("content-encoding")) { return }
    if (res.body.len < from) { return }
    if (not acceptsGzip(req.headerOr("accept-encoding", ""))) { return }

    val packed = gzip(res.body)
    // It can still come out bigger — short, high-entropy text does — and a
    // response that grew is a slower page whatever the header says.
    if (packed.len >= res.body.len) { return }
    res.body = packed
    res.with("content-encoding", "gzip")
}

/// A server over a routing table, with the defaults a development machine
/// wants: localhost, one line of log per request, and limits that are large
/// enough not to be met by accident and small enough to be a limit.
public func server(router: Router, port: Int = 8080, host: String = "127.0.0.1"): Server {
    val conns: Map<Int, Conn> = {}
    val timers: List<Timer> = []
    return Server(router, host, port, { r -> dispatch(router, r) }, true,
                  64 * 1024, 8 * 1024 * 1024, 30000, true, 512,
                  1024 * 1024, ".", 1000,
                  { fd: Int, req: Request -> }, { fd: Int, message: String -> }, { fd: Int -> },
                  { -> }, 5000,
                  -1, conns, timers, false)
}

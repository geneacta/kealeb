/// The front door.
///
/// Everything below is a convenience over `Router` and `Server`, which are
/// the real objects and remain available. An application that outgrows this
/// file keeps its handlers and stops calling `app()`; nothing here is load
/// bearing.
///
///     val a = app()
///     a.page("/", { req -> column([h1("Hello"), p("from Keal")]) })
///     a.run(8080)

import "./auth.keal"
import "./bytes.keal"
import "./css.keal"
import "./ffi.keal"
import "./http.keal"
import "./live.keal"
import "./router.keal"
import "./server.keal"
import "./text.keal"
import "./theme.keal"
import "./ui.keal"
import "./ws.keal"

/// What every page is wrapped in.
///
/// A class rather than three fields on `App`, and the reason is a bug this
/// had: a page handler used to read the title and the stylesheet **when the
/// route was registered**, so `site.style = "/mine.css"` written after
/// `site.page(...)` silently did nothing. The handlers capture this object
/// once and read it per request, so the order of the lines in a program stops
/// mattering. It is filled from the `App` when the server is built, which is
/// after every registration and before every request.
public class Chrome(
    public var title: String,
    public var style: String,
    package var head: List<String>,
    /// Set by `App.secure`. Held here rather than on the `App` for the same
    /// reason the title is: the page handlers capture this object once, and
    /// `secure` may be called after the pages are registered.
    package var guard: Auth?
) {
    package func markup(): String { return this.head.join("\n") }
}

/// The rest of the chain, from inside a filter.
///
/// A class rather than a bare function so that `next.on(req)` reads as what it
/// is, and so that there is somewhere to put the next thing a filter needs to
/// know without changing every filter ever written.
public class Next(package val rest: (Request) -> Response) {
    /// Carry on. A filter that does not call this has answered by itself,
    /// which is what a filter refusing a request looks like.
    public func on(req: Request): Response { return this.rest(req) }
}

/// A file the application serves out of memory, at a URL naming its contents.
package class Asset(
    package val url: String,
    package val mime: String,
    package val body: String,
    package val tag: String
)

/// Something to run on a schedule, held until there is a server to run it.
package class Job(package val ms: Int, package val once: Bool, package val run: () -> Unit)

/// An application: a routing table, a title, and the defaults a page gets.
public class App(
    /// The table every registration lands in.
    public val router: Router,
    /// What `page` puts in `<title>` unless told otherwise.
    public var title: String,
    /// Markup added to every page's `<head>`.
    public var head: String,
    /// The stylesheet every page links. `""` for none.
    public var style: String,
    /// One line of log per request.
    public var log: Bool,
    /// Every live page this application has open.
    public val live: Hub,
    /// What wraps every page. Filled from the four fields above when the
    /// server is built; read on every request.
    public val chrome: Chrome,
    package var assets: List<Asset>,
    package var jobs: List<Job>,
    package var protection: Auth?,
    package var filters: List<(Request, Next) -> Response>
) {
    /// Put a filter around every request.
    ///
    ///     site.use({ req, next ->
    ///         val started = monoMs()
    ///         val res = next.on(req)
    ///         println("${req.method} ${req.path} ${monoMs() - started}ms")
    ///         res
    ///     })
    ///
    /// Filters run in the order they were added, outermost first, and each one
    /// decides whether to call `next.on(req)` at all — so refusing a request is
    /// answering without calling it, and changing an answer is calling it and
    /// adjusting what comes back.
    ///
    /// They sit **inside** what `secure` installs and **outside** the router,
    /// so a filter never sees a request that failed its CSRF check, and
    /// everything a filter answers still gets the response headers.
    ///
    /// A filter is held by the application, so the rule that holds everywhere
    /// else holds here: it must not capture the application. Read what it needs
    /// into a local first.
    public proc use(filter: (Request, Next) -> Response) { this.filters.add(filter) }
    /// Switch on the four things every application should have and none should
    /// have to write.
    ///
    /// * Every form gets a hidden CSRF token, put there by the framework.
    /// * Every `POST`, `PUT`, `PATCH` and `DELETE` is refused without it.
    /// * Every response carries the headers that stop a browser doing
    ///   something helpful with it.
    /// * A WebSocket upgrade from another origin is refused.
    ///
    /// One line, and there is no configuration because there is nothing here
    /// anybody should want to turn off. What you keep is what an application
    /// really has to decide: who may sign in, and what they may then do.
    public proc secure(a: Auth) {
        this.protection = a
        this.chrome.guard = a
    }
    // ------------------------------------------------------------- routes

    public proc get(path: String, handler: (Request) -> Response) { this.router.get(path, handler) }
    public proc post(path: String, handler: (Request) -> Response) { this.router.post(path, handler) }
    public proc put(path: String, handler: (Request) -> Response) { this.router.put(path, handler) }
    public proc patch(path: String, handler: (Request) -> Response) { this.router.patch(path, handler) }
    public proc delete(path: String, handler: (Request) -> Response) { this.router.delete(path, handler) }
    public proc any(path: String, handler: (Request) -> Response) { this.router.any(path, handler) }

    /// A page: a function from a request to a tree, wrapped in a whole
    /// document and sent. This is the static half of the framework — every
    /// byte is computed once, there is no JavaScript, and the result works in
    /// anything that can read HTML.
    public proc page(path: String, build: (Request) -> Node, title: String = "") {
        // Read into locals first, and keep doing it now that the compiler
        // allows the other shape.
        //
        // The router keeps this handler, the App keeps the router. A lambda
        // that captured `this` would close that ring, and reference counting
        // cannot open one: measured, changing this one line to read
        // `this.head` inside the lambda leaks the App, the Router, every
        // Route and the Hub, and the audit calls it a cycle. Every
        // registration in this file has this shape for that reason, and
        // `tests/lifetime.keal` is what keeps it.
        val chrome = this.chrome
        val own = title
        this.router.get(path, { req ->
            html(doc(own.isEmpty() ? chrome.title : own, guarded(chrome, req, build(req)),
                     chrome.markup(), chrome.style))
        })
    }

    /// A page that also answers `POST` — the shape a form takes when it is
    /// written without any JavaScript: `build` renders, `submit` acts and
    /// answers a redirect or a tree of its own.
    public proc formPage(path: String, build: (Request) -> Node,
                         onPost: (Request) -> Response, title: String = "") {
        this.page(path, build, title)
        this.router.post(path, onPost)
    }

    /// A live page.
    ///
    /// `open` is called once per visitor, and what it answers is called again
    /// after every event. The state a page keeps is whatever `open` closes
    /// over, so it is per visitor by construction — there is no session map to
    /// remember to key correctly.
    ///
    ///     site.livePage("/", { req ->
    ///         var count = 0
    ///         view({ -> column([
    ///             h1("Clicked ${count} times"),
    ///             button("Click me", { e -> count = count + 1 })
    ///         ]) })
    ///     })
    public proc livePage(path: String, open: (Request) -> View, title: String = "") {
        val chrome = this.chrome
        val pages = this.live
        val own = title
        this.router.get(path, { req ->
            html(pages.begin(open(req), own.isEmpty() ? chrome.title : own,
                             chrome.markup(), chrome.style))
        })
    }

    // -------------------------------------------------- styles and scripts

    /// Serve a stylesheet the program built, and link it from every page.
    ///
    /// The URL names the content — `/kealeb/asset-2b7c19f4e1.css` — so it can
    /// be cached for a year and still change the instant the stylesheet does.
    /// Answers that URL, for a page that wants to reference it itself.
    ///
    ///     site.css(sheet([rule(".hero").bg("#2f6feb").fg("white")]))
    public func css(text: String): String {
        return this.asset(text, "css", "text/css; charset=utf-8",
                          "<link rel=\"stylesheet\" href=\"%\">")
    }

    /// The same for JavaScript, loaded with `defer`.
    ///
    /// kealeb's whole point is that you do not need this — the events and the
    /// rendering are Keal, on the server. It is here for the things that are
    /// genuinely the browser's: a map widget, a chart library, an analytics
    /// tag. If you find yourself writing application logic in here, the
    /// framework has failed at something and it is worth saying which.
    public func script(text: String): String {
        return this.asset(text, "js", "text/javascript; charset=utf-8",
                          "<script src=\"%\" defer></script>")
    }

    func asset(text: String, ext: String, mime: String, tag: String): String {
        val id = hex(sha1(bufOf(text))).substring(0, 10)
        val url = "/kealeb/asset-${id}.${ext}"
        this.assets.add(Asset(url, mime, text, tag.replace("%", url)))
        return url
    }

    /// Link a stylesheet this application does not serve — a CDN, or a file
    /// under `files()`.
    public proc linkStyle(href: String) {
        this.head = "${this.head}<link rel=\"stylesheet\" href=\"${href}\">"
    }

    /// Put markup in every page's `<head>`. A favicon, a font, a meta tag.
    public proc inHead(markup: String) { this.head = this.head + markup }

    // ------------------------------------------------------------ the jobs

    /// Run something every `ms`, for as long as the server runs.
    ///
    /// It runs on the loop's own thread, between requests and never during
    /// one, so it reads and writes what a handler reads and writes with
    /// nothing to synchronise — and a job that blocks blocks the server, for
    /// the same reason and with the same remedy.
    ///
    ///     site.every(60000, { -> sweepExpired(sessions) })
    ///
    /// The same rule as a handler applies to what it captures: a job must not
    /// hold the application, or the application never dies. `tests/lifetime.keal`
    /// is what keeps that true here.
    public proc every(ms: Int, job: () -> Unit) { this.jobs.add(Job(ms, false, job)) }

    /// Run something once, `ms` from the moment the server starts.
    public proc after(ms: Int, job: () -> Unit) { this.jobs.add(Job(ms, true, job)) }

    // ------------------------------------------------------------ mistakes

    /// What a visitor sees when nothing matched.
    ///
    /// A page, like every other page — wrapped in the document, with the
    /// stylesheet, in the site's own shape. It replaces the answer **only when
    /// the client asked for HTML**, so an API's 404 stays the short honest
    /// thing a program can read.
    ///
    ///     site.onNotFound({ req -> column([h1("Nothing here"), link("/", "home")]) })
    public proc onNotFound(build: (Request) -> Node) {
        val chrome = this.chrome
        this.use({ req, next ->
            val res = next.on(req)
            if ((res.code == 404) and wantsHtml(req)) {
                html(doc("Not found", guarded(chrome, req, build(req)),
                         chrome.markup(), chrome.style)).status(404)
            } else {
                res
            }
        })
    }

    /// The same for a handler that threw.
    ///
    /// It does not see what was thrown, and that is on purpose: whatever a
    /// handler threw may hold a query, a path or a password, and a page is the
    /// one place that must not carry it. The message is already on standard
    /// output, where a person who can read the log can read it, and the log is
    /// not a thing a stranger can read.
    public proc onError(build: (Request) -> Node) {
        val chrome = this.chrome
        this.use({ req, next ->
            val res = next.on(req)
            if ((res.code == 500) and wantsHtml(req)) {
                html(doc("Something went wrong", guarded(chrome, req, build(req)),
                         chrome.markup(), chrome.style)).status(500)
            } else {
                res
            }
        })
    }

    // ------------------------------------------------------------- assets

    /// Serve a directory. `/static/{path...}` under `prefix`, read from
    /// `dir`. A path that tries to leave the directory is a 403, not a
    /// cleverly normalised 200.
    public proc files(prefix: String, dir: String) {
        val root = dir.endsWith("/") ? dir.substring(0, dir.length - 1) : dir
        val at = prefix.endsWith("/") ? prefix.substring(0, prefix.length - 1) : prefix
        this.router.get("${at}/{path...}", { req ->
            serveFile(root, req.param("path"), req.headerOr("if-none-match", ""),
                      req.headerOr("range", ""))
        })
    }

    /// Serve one file at one path — a favicon, a `robots.txt`.
    public proc file(path: String, filePath: String) {
        this.router.get(path, { req ->
            serveFile("", filePath, req.headerOr("if-none-match", ""), req.headerOr("range", ""))
        })
    }

    // ---------------------------------------------------------------- run

    /// Build the server this application describes, without starting it.
    /// A test wants this: `open()` for the port, `tick()` to drive it.
    public func serverOn(port: Int, host: String = "127.0.0.1"): Server {
        this.mount()
        val s = server(this.router, port, host)
        for (j in this.jobs) {
            if (j.once) { s.after(j.ms, j.run) } else { s.every(j.ms, j.run) }
        }
        s.log = this.log
        // The chain, built from the inside out: the router is the innermost
        // thing, each filter wraps what is already there, and `secure` — if it
        // is on — wraps the lot.
        val router = this.router
        // The catch is here, around the router, and not further out — which
        // matters more than it looks. A handler that throws unwinds every
        // filter around it on the way, so a catch outside the filters would
        // produce a 500 that no filter ever sees: `onError` could not replace
        // it, and a logging filter would not record the one request most worth
        // recording. Inside, a throw becomes an ordinary 500 that travels back
        // out through the chain like any other answer.
        var chain: (Request) -> Response = { req -> attempted(router, req) }
        var at = this.filters.size - 1
        while (at >= 0) {
            val filter = this.filters[at]
            val inner = chain
            chain = { req -> filter(req, Next(inner)) }
            at = at - 1
        }
        val a = this.protection
        if (a == null) {
            s.handle = chain
        } else {
            val guarded = chain
            s.handle = { req -> defended(a, guarded, req) }
        }
        val pages = this.live
        pages.host = s
        s.onOpen = { fd: Int, req: Request -> pages.opened(fd, req.queryOr("s")) }
        s.onMessage = { fd: Int, message: String -> pages.receive(fd, message) }
        s.onClose = { fd: Int -> pages.detach(fd) }
        return s
    }

    /// Serve, until the process is stopped.
    public proc run(port: Int = 8080, host: String = "127.0.0.1") {
        this.serverOn(port, host).run()
    }

    /// Register what every kealeb application answers. Called by `serverOn`;
    /// calling it twice is harmless because a later route never shadows an
    /// earlier one of the same shape — the first wins, and these are first
    /// only if nothing else claimed the path.
    package proc mount() {
        if (this.mounted) { return }
        this.mounted = true

        // The chrome is fixed here — after every registration, before every
        // request — so a program may set its title, its stylesheet and its
        // assets in any order it likes, and in any order relative to its
        // pages.
        this.chrome.title = this.title
        this.chrome.style = this.style
        if (not this.head.isEmpty()) { this.chrome.head.add(this.head) }
        for (a in this.assets) {
            val body = a.body
            val mime = a.mime
            this.chrome.head.add(a.tag)
            // A URL that names its own contents can be cached for ever,
            // because different contents are a different URL.
            this.router.get(a.url, { req ->
                text(body).type(mime).with("cache-control", "public, max-age=31536000, immutable")
            })
        }

        this.router.get("/kealeb/kealeb.css",
            { req -> text(stylesheet).type("text/css; charset=utf-8").with("cache-control", "max-age=300") })
        this.router.get("/kealeb/kealeb.js",
            { req -> text(clientScript).type("text/javascript; charset=utf-8").with("cache-control", "max-age=300") })
        this.router.get("/kealeb/live", { req -> upgradeToSocket(req) })
    }

    package var mounted: Bool = false
}

/// A new application, with the defaults a first program wants.
public func app(title: String = "kealeb"): App {
    val head: List<String> = []
    val assets: List<Asset> = []
    val jobs: List<Job> = []
    val filters: List<(Request, Next) -> Response> = []
    return App(Router(), title, "", "/kealeb/kealeb.css", true, hub(),
               Chrome(title, "/kealeb/kealeb.css", head, null), assets, jobs, null, filters)
}

/// Run the router, and turn what a handler throws into a 500.
///
/// What was thrown goes to standard output and no further. It may hold a
/// query, a path, a password — anything the handler was holding when it gave
/// up — so it goes where a person who can read the log can read it, and the
/// log is not a thing a stranger can read.
package func attempted(router: Router, req: Request): Response {
    try {
        return dispatch(router, req)
    } catch (e) {
        println("kealeb: handler for ${req.method} ${req.path} threw: ${e}")
        return serverError()
    }
}

/// Did this client ask for a page, or for something a program reads?
///
/// A browser sends `text/html` in its `Accept`; `fetch` and `curl` send `*/*`
/// or nothing. The difference decides whether an error is a page or a
/// sentence, and getting it wrong means an API's error handling has to parse
/// HTML.
public func wantsHtml(req: Request): Bool {
    return req.headerOr("accept", "").toLower().contains("text/html")
}

/// Put the CSRF token into every form on a page.
///
/// A walk over the tree rather than something the program writes, because a
/// token you have to remember is a token somebody forgets on the one form that
/// mattered. Only the methods that change something get one: a `GET` form
/// would carry it into the query string, where it does not belong and where it
/// ends up in a log.
package func guarded(chrome: Chrome, req: Request, var tree: Node): Node {
    val a = chrome.guard
    if (a == null) { return tree }
    stampForms(tree, a.csrfToken(req))
    return tree
}

proc stampForms(var node: Node, token: String) {
    if (node.tag == "form") {
        val how = node.attrOf("method").toLower()
        if (not ((how == "") or (how == "get"))) {
            node.kids.insert(0, el("input").attr("type", "hidden")
                                           .attr("name", csrfField).attr("value", token))
        }
    }
    for (k in node.kids) { stampForms(k, token) }
}

/// The headers a response should carry whatever else it says.
///
/// Each one stops a browser being helpful in a way nobody asked for: guessing
/// a media type, putting the page in somebody else's frame, sending the full
/// URL to a third party, or running a script from anywhere but here. The
/// content policy is strict enough to be worth having — `default-src 'self'`,
/// no inline script — which is why the live client's session id is an
/// attribute rather than the `<script>` tag it used to be.
package func hardened(res: Response): Response {
    // One statement per header rather than a chain: Keal ends a statement at a
    // newline when the previous token could end one, so a leading `.` on the
    // next line is a new statement and not a continuation.
    res.with("x-content-type-options", "nosniff")
    res.with("referrer-policy", "same-origin")
    res.with("x-frame-options", "DENY")
    res.with("content-security-policy",
             "default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'")
    return res
}

/// Everything `secure` installs, on the way in and on the way out.
package func defended(a: Auth, inner: (Request) -> Response, req: Request): Response {
    val changes = ((req.method == "POST") or (req.method == "PUT")) or
                  ((req.method == "PATCH") or (req.method == "DELETE"))
    if (changes and (not a.csrfOk(req))) {
        // Deliberately not specific. A page that legitimately posts here has
        // the token; anything that does not, learns nothing from the answer.
        return notFound("This request did not come from this site").status(403)
    }
    return hardened(inner(req))
}

/// Answer a browser asking to turn this connection into a WebSocket.
///
/// The three checks are the protocol's, in the order it states them, and each
/// refusal says which one failed — an upgrade that fails silently is an
/// afternoon nobody gets back.
public func upgradeToSocket(req: Request): Response {
    if (not req.isUpgrade()) {
        return badRequest("/kealeb/live is a WebSocket endpoint").status(426).with("upgrade", "websocket")
    }
    if (req.headerOr("sec-websocket-version", "") != "13") {
        return badRequest("this server speaks WebSocket version 13").with("sec-websocket-version", "13")
    }
    val key = req.headerOr("sec-websocket-key", "")
    if (key.isEmpty()) {
        return badRequest("no Sec-WebSocket-Key")
    }
    // A browser always sends `Origin` on a WebSocket, and a page on another
    // site sends its own — which is the cross-site request the same-origin
    // policy does not cover for sockets. Something with no `Origin` at all is
    // not a browser, and refusing it would refuse every test and every tool.
    val origin = req.headerOr("origin", "")
    if (not origin.isEmpty()) {
        val host = req.headerOr("host", "")
        val from = after(origin, "//")
        if (from != host) {
            return notFound("A socket from ${origin} is not one this site opened").status(403)
        }
    }
    val headers: Map<String, String> = {}
    headers.set("upgrade", "websocket")
    headers.set("connection", "Upgrade")
    headers.set("sec-websocket-accept", acceptKey(key))
    return switching(headers)
}

// ------------------------------------------------------------ static files

/// What an extension means. Short on purpose: a type nobody serves is a type
/// nobody has to read past.
public func mimeOf(path: String): String {
    val dot = path.reversed().indexOf(".")
    if (dot < 0) { return "application/octet-stream" }
    val ext = path.substring(path.length - dot, path.length).toLower()
    return when (ext) {
        "html" -> "text/html; charset=utf-8"
        "htm" -> "text/html; charset=utf-8"
        "css" -> "text/css; charset=utf-8"
        "js" -> "text/javascript; charset=utf-8"
        "mjs" -> "text/javascript; charset=utf-8"
        "json" -> "application/json"
        "txt" -> "text/plain; charset=utf-8"
        "md" -> "text/markdown; charset=utf-8"
        "csv" -> "text/csv; charset=utf-8"
        "xml" -> "application/xml"
        "svg" -> "image/svg+xml"
        "png" -> "image/png"
        "jpg" -> "image/jpeg"
        "jpeg" -> "image/jpeg"
        "gif" -> "image/gif"
        "webp" -> "image/webp"
        "avif" -> "image/avif"
        "ico" -> "image/x-icon"
        "woff" -> "font/woff"
        "woff2" -> "font/woff2"
        "ttf" -> "font/ttf"
        "otf" -> "font/otf"
        "pdf" -> "application/pdf"
        "wasm" -> "application/wasm"
        "zip" -> "application/zip"
        "mp3" -> "audio/mpeg"
        "mp4" -> "video/mp4"
        "webm" -> "video/webm"
        else -> "application/octet-stream"
    }
}

/// Is this a path a request is allowed to name?
///
/// The rule is refusal rather than normalisation: any `..` segment, any
/// leading `/`, any backslash, and any NUL is a 403. Normalising a hostile
/// path is how a directory gets escaped — the fix is to not accept one.
public func safePath(rel: String): Bool {
    if (rel.isEmpty()) { return false }
    if (rel.startsWith("/") or rel.contains("\\")) { return false }
    for (part in rel.split("/")) {
        if (part == "..") { return false }
        if (part.startsWith(".") and (part.length > 1)) { return false }
    }
    return true
}

/// Below this many bytes a file is read into memory, and above it the server
/// sends it as it reads it.
///
/// The line is where two things swap places. A small file wants to be in
/// memory: it can be compressed, which is worth four or five times its size on
/// a stylesheet, and holding it costs nothing. A large one wants the opposite:
/// compressing a film is pointless because a film is already compressed, and
/// holding it is the difference between serving one and refusing to.
public var streamFrom: Int = 1024 * 1024

/// Read a file and answer it, or answer why not.
///
/// The ETag is the file's timestamp and size, which is what a cache needs and
/// all a static file can honestly promise; a client that sends it back gets a
/// 304 and no body. A `Range` gets a 206, or a 416 when the slice is not
/// there.
public func serveFile(root: String, rel: String, ifNoneMatch: String = "",
                      range: String = ""): Response {
    if (not root.isEmpty()) {
        if (not safePath(rel)) { return notFound("Forbidden").status(403) }
    }
    val path = root.isEmpty() ? rel : "${root}/${rel}"
    val stamp = fileMtime(path)
    if (stamp < 0) { return notFound("No such file: ${rel}") }
    val size = fileSize(path)
    if (size < 0) { return notFound("No such file: ${rel}") }

    val tag = "\"${stamp}-${size}\""
    if (ifNoneMatch.contains(tag)) {
        return noContent().status(304).with("etag", tag)
    }

    var from = 0
    var length = size
    var partial = false
    val span = parseRange(range, size)
    if (span != null) {
        if (not span.satisfiable) {
            val no = notFound("That range is not in this file").status(416)
            return no.with("accept-ranges", "bytes").with("content-range", "bytes */${size}")
        }
        from = span.from
        length = span.length()
        partial = true
    }

    var res = notFound("")
    if (length > streamFrom) {
        // Big: the server opens it and sends it as the socket takes it, so
        // nothing here holds it.
        res = fileBody(mimeOf(path), path, from, length)
    } else {
        val h = fileRead(path)
        if (h == 0) { return notFound("Could not read ${rel}").status(500) }
        val body = buf(length + 1)
        body.raw(h, from, length)
        blobFree(h)
        res = bytes(mimeOf(path), body)
    }

    if (partial) {
        res.status(206)
        res.with("content-range", "bytes ${from}-${(from + length) - 1}/${size}")
    }
    res.with("accept-ranges", "bytes")
    res.with("etag", tag)
    res.with("last-modified", httpDate(stamp))
    return res
}
